# ChalaMob CRM backend: copy this file to ".env" and fill in your own values.
#   cp .env.example .env
# Never commit the real .env file. It holds your database password and signing secret.

# Port the API listens on.
PORT=3001

# "development" or "production".
NODE_ENV=development

# PostgreSQL connection string:  postgres://USER:PASSWORD@HOST:5432/DATABASE
# Hosted databases (Render, Railway, Neon, Supabase...) give you this exact string.
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/chalamob

# Secret used to sign login tokens. Use a long random value, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it signs everyone out.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# How long a login lasts. 30 days lets staff keep working offline for weeks.
JWT_EXPIRES_IN=30d

# The shop's time zone. "Today" in reports, the daily totals and repair reminders
# follow this, so set it to where the shop is (the server's own clock is used otherwise).
TZ=Africa/Addis_Ababa

# Product photos are stored at Cloudinary (free plan is plenty). Create an account at
# cloudinary.com, then copy these three values from its dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Address of the public web store, so only it may call /api/public from a browser.
# Several can be given, separated by commas. Leave empty while developing.
STOREFRONT_ORIGIN=

# Forgotten password. The app emails a 6-digit code. The free host blocks ordinary mail ports,
# so use a mail service's web API: set ONE key and the sender address.
#   Brevo (brevo.com, free 300 a day): create an API key, and verify MAIL_FROM as a sender there.
#   Resend (resend.com): create an API key; MAIL_FROM must be on a domain you verified.
BREVO_API_KEY=
RESEND_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Chala Mobile

# A long secret only the owner knows. It lets the owner choose a new password without email
# (Sign in > Forgot your password > "I already have a code or recovery key"). Leave empty to switch it off.
OWNER_RECOVERY_KEY=
