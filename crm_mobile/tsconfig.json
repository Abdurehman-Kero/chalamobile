{
  "extends": "@react-native/typescript-config",
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"],
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@theme/*":      ["src/theme/*"],
      "@components/*": ["src/components/*"],
      "@screens/*":    ["src/screens/*"],
      "@store/*":      ["src/store/*"],
      "@api/*":        ["src/api/*"],
      "@utils/*":      ["src/utils/*"]
    }
  }
}

