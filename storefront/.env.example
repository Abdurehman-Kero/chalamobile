# Copy to .env.local for development. For the published site, .env.production already holds the
# settings; set the same names on the hosting service to override them.

# Address of the Chala CRM API, ending in /api.
VITE_API_URL=https://chalamob-backend.onrender.com/api

# Shown in the header, footer and "call us" buttons.
VITE_SHOP_PHONE=+251911720282

# The store's own address once it has one (no trailing slash). Optional.
VITE_SITE_URL=
